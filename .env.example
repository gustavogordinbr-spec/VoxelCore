# Leia e aceite a EULA do Minecraft antes de trocar para TRUE:
# https://www.minecraft.net/eula
EULA=FALSE

# Identidade do servidor
SERVER_NAME=VoxelCore
LEVEL_NAME=VoxelCore
SERVER_VERSION=LATEST
TIMEZONE=America/Sao_Paulo

# Jogabilidade
GAMEMODE=survival
DIFFICULTY=normal
MAX_PLAYERS=10
ALLOW_CHEATS=false
VIEW_DISTANCE=16
TICK_DISTANCE=4
TEXTUREPACK_REQUIRED=true

# Segurança. Mantenha true em um servidor exposto à internet.
# Informe os gamertags separados por vírgula, sem espaços extras.
ALLOW_LIST=true
ALLOW_LIST_USERS=
OPS=

# Porta UDP pública no host/VPS.
SERVER_PORT=19132

# Opcional: chave secreta do agente em https://playit.gg/account/agents
# Nunca publique esta chave nem envie o arquivo .env ao GitHub.
PLAYIT_SECRET=

# Limites de segurança usados ao descompactar add-ons.
MAX_ADDON_FILES=20000
MAX_ADDON_UNPACKED_MB=1024

